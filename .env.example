NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
DATABASE_URL=sqlite:///./focusverify.db
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
MODEL_CONFIG=focusverify-v1
